# --- CẤU HÌNH API KEYS ---
# Khóa API Google Gemini để chạy các tác tử (Bắt buộc nếu chạy thực tế)
GEMINI_API_KEY=your_gemini_api_key_here

# --- CẤU HÌNH TÍCH HỢP PLANKA (FNX-OP) ---
# Địa chỉ URL của hệ thống Planka của bạn
PLANKA_API_URL=https://operation.fnx.vn

# Tài khoản Bot Planka để tạo thẻ và ghi log
PLANKA_EMAIL=bot-agent@fnx.vn
PLANKA_PASSWORD=securepassword

# Chế độ Mock Planka:
# - True: Giả lập đẩy kết quả lên Planka (chỉ in JSON ra log, không gọi API thật)
# - False: Đẩy kết quả thật lên Planka qua REST API
PLANKA_MOCK_MODE=True

# Mã khóa bảo mật Webhook (Dùng để xác thực request gửi đến từ FNX-OP backend)
WEBHOOK_SECRET_TOKEN=fnx-op-secret-token-2026

# --- CẤU HÌNH MODEL MAPPING (GEMINI STRATEGY) ---
MODEL_NAVIGATOR=gemini-2.0-flash
MODEL_SCANNER=gemini-1.5-pro
MODEL_BUILDER=gemini-1.5-pro
MODEL_CHALLENGER=gemini-2.0-flash
MODEL_JUDGE=gemini-1.5-pro

# --- CẤU HÌNH GIỚI HẠN LOGIC (POKA-YOKE) ---
# Hạn mức số luồng LLM chạy đồng thời song song tối đa
MAX_CONCURRENT_LLM_TASKS=5
# Số vòng Navigator hỏi làm rõ tối đa trước khi từ chối
MAX_CLARIFICATION_TURNS=3
# Số vòng debate tối đa giữa Challenger và Judge
MAX_DEBATE_TURNS=3
